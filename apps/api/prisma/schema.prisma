generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BARBEIRO
}

enum AppointmentStatus {
  AGENDADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum SubscriptionStatus {
  ATIVA
  PAUSADA
  CANCELADA
}

enum SubscriptionPaymentStatus {
  PENDENTE
  PAGO
}

enum PaymentMethod {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  OUTRO
}

enum ReminderStatus {
  PENDENTE
  ENVIADO
  FALHOU
  IGNORADO
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  phone        String?
  role         Role          @default(BARBEIRO)
  commission   Decimal       @default(40) @db.Decimal(5, 2)
  workStart    String        @default("09:00")
  workEnd      String        @default("19:00")
  active       Boolean       @default(true)
  appointments Appointment[] @relation("BarberAppointments")
  scheduleBlocks ScheduleBlock[]
  expenses     Expense[]      @relation("ExpenseCreator")
  cashClosings CashClosing[]  @relation("CashClosingUser")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Client {
  id           String        @id @default(uuid())
  name         String
  phone        String?
  appointments Appointment[]
  subscriptions ClientSubscription[]
  notes        String?
  createdAt    DateTime      @default(now())
}

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  visitsPerMonth Int    @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  services    Service[] @relation("PlanServices")
  subscriptions ClientSubscription[]
}

model ClientSubscription {
  id         String             @id @default(uuid())
  clientId   String
  client     Client             @relation(fields: [clientId], references: [id])
  planId     String
  plan       SubscriptionPlan   @relation(fields: [planId], references: [id])
  price      Decimal            @db.Decimal(10, 2)
  visitsPerMonth Int
  includedServices Service[] @relation("SubscriptionServices")
  billingDay Int
  startDate  DateTime
  billingFrom DateTime
  status     SubscriptionStatus @default(ATIVA)
  payments   SubscriptionPayment[]
  appointments Appointment[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([clientId, status])
}

model SubscriptionPayment {
  id             String                    @id @default(uuid())
  subscriptionId String
  subscription   ClientSubscription        @relation(fields: [subscriptionId], references: [id])
  period         String
  dueDate        DateTime
  amount         Decimal                   @db.Decimal(10, 2)
  status         SubscriptionPaymentStatus @default(PENDENTE)
  paidAt         DateTime?
  paymentMethod  PaymentMethod?
  createdAt      DateTime                  @default(now())

  @@unique([subscriptionId, period])
  @@index([status, dueDate])
  @@index([paidAt])
}

model Service {
  id           String        @id @default(uuid())
  name         String
  description  String?
  duration     Int
  price        Decimal       @db.Decimal(10, 2)
  active       Boolean       @default(true)
  appointments Appointment[]
  plans        SubscriptionPlan[] @relation("PlanServices")
  subscriptionEntitlements ClientSubscription[] @relation("SubscriptionServices")
}

model Appointment {
  id        String            @id @default(uuid())
  date      DateTime
  status    AppointmentStatus @default(AGENDADO)
  priceAtBooking Decimal? @db.Decimal(10, 2)
  commissionAtBooking Decimal? @db.Decimal(5, 2)
  paymentMethod PaymentMethod?
  barberId  String
  barber    User              @relation("BarberAppointments", fields: [barberId], references: [id])
  clientId  String
  client    Client            @relation(fields: [clientId], references: [id])
  serviceId String
  service   Service           @relation(fields: [serviceId], references: [id])
  subscriptionId String?
  subscription ClientSubscription? @relation(fields: [subscriptionId], references: [id])
  reminder  AppointmentReminder?
  createdAt DateTime          @default(now())

  @@index([barberId, date])
  @@index([date, status])
  @@index([subscriptionId, date])
}

model ScheduleBlock {
  id        String   @id @default(uuid())
  barberId  String
  barber    User     @relation(fields: [barberId], references: [id])
  start     DateTime
  end       DateTime
  reason    String
  createdAt DateTime @default(now())

  @@index([barberId, start, end])
}

model Expense {
  id            String        @id @default(uuid())
  description   String
  category      String
  amount        Decimal       @db.Decimal(10, 2)
  date          DateTime
  paymentMethod PaymentMethod
  createdById   String
  createdBy     User          @relation("ExpenseCreator", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([date])
}

model CashClosing {
  id              String   @id @default(uuid())
  businessDate    String   @unique
  openingAmount   Decimal  @db.Decimal(10, 2)
  expectedAmount  Decimal  @db.Decimal(10, 2)
  actualAmount    Decimal  @db.Decimal(10, 2)
  difference      Decimal  @db.Decimal(10, 2)
  revenue         Decimal  @db.Decimal(10, 2)
  expenses        Decimal  @db.Decimal(10, 2)
  notes           String?
  closedById      String
  closedBy        User     @relation("CashClosingUser", fields: [closedById], references: [id])
  closedAt        DateTime @default(now())
}

model AppointmentReminder {
  id          String         @id @default(uuid())
  appointmentId String       @unique
  appointment Appointment    @relation(fields: [appointmentId], references: [id])
  scheduledFor DateTime
  status      ReminderStatus @default(PENDENTE)
  destination String
  providerId  String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())

  @@index([status, scheduledFor])
}

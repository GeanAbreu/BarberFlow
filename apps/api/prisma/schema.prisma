generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BARBEIRO
}

enum AppointmentStatus {
  AGENDADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum SubscriptionStatus {
  ATIVA
  PAUSADA
  CANCELADA
}

enum SubscriptionPaymentStatus {
  PENDENTE
  PAGO
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  phone        String?
  role         Role          @default(BARBEIRO)
  commission   Decimal       @default(40) @db.Decimal(5, 2)
  workStart    String        @default("09:00")
  workEnd      String        @default("19:00")
  active       Boolean       @default(true)
  appointments Appointment[] @relation("BarberAppointments")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Client {
  id           String        @id @default(uuid())
  name         String
  phone        String?
  appointments Appointment[]
  subscriptions ClientSubscription[]
  createdAt    DateTime      @default(now())
}

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  visitsPerMonth Int    @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  services    Service[] @relation("PlanServices")
  subscriptions ClientSubscription[]
}

model ClientSubscription {
  id         String             @id @default(uuid())
  clientId   String
  client     Client             @relation(fields: [clientId], references: [id])
  planId     String
  plan       SubscriptionPlan   @relation(fields: [planId], references: [id])
  price      Decimal            @db.Decimal(10, 2)
  visitsPerMonth Int
  includedServices Service[] @relation("SubscriptionServices")
  billingDay Int
  startDate  DateTime
  billingFrom DateTime
  status     SubscriptionStatus @default(ATIVA)
  payments   SubscriptionPayment[]
  appointments Appointment[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([clientId, status])
}

model SubscriptionPayment {
  id             String                    @id @default(uuid())
  subscriptionId String
  subscription   ClientSubscription        @relation(fields: [subscriptionId], references: [id])
  period         String
  dueDate        DateTime
  amount         Decimal                   @db.Decimal(10, 2)
  status         SubscriptionPaymentStatus @default(PENDENTE)
  paidAt         DateTime?
  createdAt      DateTime                  @default(now())

  @@unique([subscriptionId, period])
  @@index([status, dueDate])
  @@index([paidAt])
}

model Service {
  id           String        @id @default(uuid())
  name         String
  description  String?
  duration     Int
  price        Decimal       @db.Decimal(10, 2)
  active       Boolean       @default(true)
  appointments Appointment[]
  plans        SubscriptionPlan[] @relation("PlanServices")
  subscriptionEntitlements ClientSubscription[] @relation("SubscriptionServices")
}

model Appointment {
  id        String            @id @default(uuid())
  date      DateTime
  status    AppointmentStatus @default(AGENDADO)
  priceAtBooking Decimal? @db.Decimal(10, 2)
  commissionAtBooking Decimal? @db.Decimal(5, 2)
  barberId  String
  barber    User              @relation("BarberAppointments", fields: [barberId], references: [id])
  clientId  String
  client    Client            @relation(fields: [clientId], references: [id])
  serviceId String
  service   Service           @relation(fields: [serviceId], references: [id])
  subscriptionId String?
  subscription ClientSubscription? @relation(fields: [subscriptionId], references: [id])
  createdAt DateTime          @default(now())

  @@index([barberId, date])
  @@index([date, status])
  @@index([subscriptionId, date])
}
